# URLs base de cada API Gateway (sin "/" final). No subir valores reales.
VITE_IDENTITY_API_URL=
VITE_EMPLOYEES_API_URL=
VITE_RECRUITMENT_API_URL=
VITE_TIMELEAVE_API_URL=
VITE_PAYROLL_API_URL=
# Opcional: si queda vacía, el frontend oculta la campana y no llama a Notifications.
VITE_NOTIFICATIONS_API_URL=
# Registro público de empresas (POST /signup en identity). Dejar en false hasta que exista el endpoint.
VITE_SIGNUP_ENABLED=false
