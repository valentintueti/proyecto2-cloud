# ── AWS (Learner Lab: copiar desde "AWS Details" en cada sesión) ──
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LAB_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole

# ── Serverless ──
APP_NAME=talentcloud
STAGE=dev

# ── Auth (common/auth.py) ──
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# ── RDS PostgreSQL (common/db_pg.py), una sola instancia, Patrón 2 ──
DB_HOST=
DB_PORT=5432
DB_USER=hcm_admin
DB_PASSWORD=
DB_EMPLOYEES_NAME=hcm_employees
DB_PAYROLL_NAME=hcm_payroll

# ── Tenants y seed ──
TENANTS=acme,globex,initech
SEED_RECORDS_PER_TENANT=10000