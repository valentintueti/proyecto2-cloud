# Copia este archivo como .env en la raíz del repo. Lo leen scripts/deploy.sh y scripts/bootstrap.py.
# Escribe valores planos: sin comillas, sin espacios alrededor del "=", sin ${...}.

# ── AWS ──
AWS_REGION=us-east-1
STAGE=dev
LAB_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole
# En una EC2 con LabInstanceProfile déjalas VACÍAS: se usan las credenciales de la instancia.
# Desde tu PC: cópialas de "AWS Details" del Learner Lab (cambian en cada sesión).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Empaquetado (serverless-python-requirements) ──
# Linux/VM: python3   ·   Windows: py
PYTHON_BIN=python3

# ── Auth ──
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
# Clave para crear empresas con POST /tenants (header x-platform-key)
PLATFORM_ADMIN_KEY=cambia-esto-clave-del-dueño-del-saas

# ── RDS PostgreSQL (la crea services/infra; el host sale de sus Outputs) ──
# Contraseña: mínimo 8 caracteres, sin / @ " ni espacios.
DB_USER=hcm_admin
DB_PASSWORD=
DB_EMPLOYEES_NAME=hcm_employees
DB_PAYROLL_NAME=hcm_payroll

# ── Frontend ──
# Origen permitido en el CORS del bucket de CVs (URL de Amplify). '*' mientras no exista.
FRONTEND_ORIGIN=*

# ── Tenants y datos de prueba (scripts/bootstrap.py) ──
TENANTS=acme,globex,initech
# Contraseña de admin@<tenant>.com (mínimo 8 caracteres)
SEED_ADMIN_PASSWORD=
SEED_RECORDS_PER_TENANT=10000
